  <property name="styleSheet">
   <string notr="true">
#LoginPage {
    background-color: #f0f4ff;
    font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
}

/* ── Left illustration panel ── */
#leftFrame {
    background-color: #dce8ff;
    border-top-left-radius: 16px;
    border-bottom-left-radius: 16px;
}
#illustrationLabel {
    color: #7a90b8;
    font-size: 14px;
    font-style: italic;
}
#logoLabel {
    font-size: 30px;
    font-weight: bold;
    color: #1a1a2e;
    letter-spacing: 2px;
}
#taglineLabel {
    font-size: 13px;
    color: #555577;
    letter-spacing: 1px;
}

/* ── Right card panel ── */
#rightFrame {
    background-color: #ffffff;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
}

#welcomeLabel {
    font-size: 24px;
    font-weight: bold;
    color: #1a1a2e;
}
#subtitleLabel {
    font-size: 13px;
    color: #888899;
}

/* ── Field labels ── */
#emailLabel, #passwordLabel {
    font-size: 11px;
    font-weight: bold;
    color: #444466;
    letter-spacing: 0.5px;
}

/* ── Line edits ── */
QLineEdit {
    border: none;
    border-bottom: 2px solid #f47920;
    border-radius: 0px;
    padding: 8px 4px;
    font-size: 13px;
    color: #1a1a2e;
    background: transparent;
}
QLineEdit:focus {
    border-bottom: 2px solid #1565c0;
}

/* ── Remember Me checkbox ── */
#rememberCheckBox {
    font-size: 12px;
    color: #444466;
    spacing: 6px;
}
#rememberCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #c0c8e0;
    border-radius: 3px;
    background: white;
}
#rememberCheckBox::indicator:checked {
    background-color: #f47920;
    border-color: #f47920;
}

/* ── Login button ── */
#loginButton {
    background-color: #2979ff;
    color: white;
    font-size: 14px;
    font-weight: bold;
    border: none;
    border-radius: 8px;
    padding: 12px;
    letter-spacing: 1px;
}
#loginButton:hover {
    background-color: #1565c0;
}
#loginButton:pressed {
    background-color: #0d47a1;
}

/* ── Sign-up label ── */
#signupLabel {
    font-size: 12px;
    color: #888899;
}
   </string>
